# Copy this file to `.env` and fill in your values.
# `.env` is git-ignored — never commit real keys.

# --- OpenRouter (LLM) ---
# Get a new key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME

# Model for parsing user input into structured logs (cheap + fast)
LLM_PARSE_MODEL=openai/gpt-4o-mini

# Model for weekly report generation (higher quality)
LLM_REPORT_MODEL=openai/gpt-4o

# Optional: identifies your app to OpenRouter for analytics
OPENROUTER_APP_URL=http://localhost:5173
OPENROUTER_APP_NAME=Personal Body Recomp Tracker

# --- Google Sheets ---
# From your sheet URL: docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SPREADSHEET_ID=REPLACE_ME

# Path to the service account JSON file downloaded from Google Cloud Console.
# Share your spreadsheet with this service account's client_email (as Editor).
GOOGLE_SERVICE_ACCOUNT_FILE=./credentials/service-account.json

# Alternative: inline the entire JSON (single line). Only one of the two is needed.
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# --- App ---
TIMEZONE=Asia/Kolkata
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

